#! /bin/bash

# Ensure hermit is loaded by the editor
eval "$("$PWD/bin/hermit" env -)"

# Tero CLI configuration - Local control plane (default for development)
export TERO_API_ENDPOINT="http://localhost:8081"
export TERO_CHAT_ENDPOINT="http://localhost:8083"
export TERO_POWERSYNC_ENDPOINT="http://localhost:8084"
# Control plane database (for code generation only - fetches column comments)
export TERO_CONTROL_PLANE_DATABASE_URL="postgres://postgres:postgres@localhost:5432/control_plane_dev?sslmode=disable"

# WorkOS client ID (same for local dev)
export TERO_WORKOS_CLIENT_ID="client_01JQCC2CJMTB8AY2JRMZXFY9R1"

# Staging environment (uncomment to use instead of local)
# export TERO_API_ENDPOINT="https://api.usetero.dev/graphql"
# export TERO_POWERSYNC_ENDPOINT="https://powersync.usetero.dev"

# Development: Skip to app mode after onboarding complete
# Set to "true" to automatically transition from onboarding complete screen to app
export TERO_SKIP_TO_APP="true"

# Development: Enable debug logging (logs written to /tmp/tero.log)
export TERO_DEBUG="true"

# Load local overrides if they exist
[[ -f .envrc.local ]] && source .envrc.local
