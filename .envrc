#! /bin/bash

# Ensure hermit is loaded by the editor
eval "$("$PWD/bin/hermit" env -)"

# Environment: local (default), dev, prd
# TERO_ENV selects per-environment defaults (endpoints, WorkOS client ID).
# Override with TERO_ENV=dev or TERO_ENV=prd. See internal/config/cli.go.
export TERO_ENV="local"

# Control plane database (for code generation only - fetches column comments)
export TERO_CONTROL_PLANE_DATABASE_URL="postgres://postgres:postgres@localhost:5432/control_plane_dev?sslmode=disable"
# PowerSync API token for schema generation (local dev uses dev-cli-token)
export POWERSYNC_API_TOKEN="${POWERSYNC_API_TOKEN:-dev-cli-token}"

# Development: Skip to app mode after onboarding complete
export TERO_SKIP_TO_APP="true"

# Development: Enable debug logging (logs written to ~/.tero/environments/{env}/tero.log)
export TERO_DEBUG="true"

# Load local overrides if they exist
[[ -f .envrc.local ]] && source .envrc.local
