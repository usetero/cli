"""Impact detection states for a distillation"""
enum DistillationImpactState {
  """Waiting to observe impact (not enough data or threshold not crossed)"""
  PENDING

  """
  Impact detected - volume dropped to expected levels for sustained period
  """
  IMPACTED

  """User dismissed this distillation - not expecting impact"""
  DISMISSED
}

"""
Impact status of a distillation.
Tracks whether the expected volume reduction has been observed.
"""
type DistillationImpactStatus {
  """
  Current status: pending (waiting for data), impacted (reduction observed), dismissed (user dismissed)
  """
  status: DistillationImpactState!

  """
  When we first observed the expected volume reduction.
  Null if status is pending or dismissed.
  """
  impactDetectedAt: Time
}

