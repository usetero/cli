"""
Service status for a specific integration account.
Tracks discovery pipeline progress: volume -> log events -> ready.
"""
type ServiceStatus {
  """Current status in the discovery pipeline"""
  status: ServiceStatusState!

  """Log event discovery progress (0-100), null if no volume data yet"""
  percentComplete: Float

  """Whether service volumes exist from this integration"""
  hasServiceVolumes: Boolean!

  """Number of log events discovered for this service"""
  logEventCount: Int!

  """Error message from service volume discovery (if ERROR_VOLUME)"""
  volumeError: String

  """Error message from log event discovery (if ERROR_LOG_EVENTS)"""
  logEventsError: String
}

"""Current status of a service in the discovery pipeline."""
enum ServiceStatusState {
  """Waiting for service volume discovery"""
  PENDING_VOLUME

  """Has service volumes, waiting for log event discovery"""
  PENDING_LOG_EVENTS

  """Discovery complete (90%+ of volume discovered)"""
  READY

  """Error during service volume discovery"""
  ERROR_VOLUME

  """Error during log event discovery"""
  ERROR_LOG_EVENTS
}

