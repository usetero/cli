"""
Log event status for a specific workspace and integration account.
Tracks preparation pipeline progress: volume -> distillation -> ready.
"""
type LogEventStatus {
  """Current status in the preparation pipeline"""
  status: LogEventStatusState!

  """Whether volume data exists from this integration"""
  hasVolumes: Boolean!

  """Whether distillation exists for this workspace"""
  hasDistillation: Boolean!

  """Error message from volume discovery (if ERROR_VOLUME)"""
  volumeError: String

  """Error message from distillation analysis (if ERROR_DISTILLATION)"""
  distillationError: String
}

"""Current status of a log event in the preparation pipeline."""
enum LogEventStatusState {
  """Waiting for volume discovery"""
  PENDING_VOLUME

  """Has volumes, waiting for distillation analysis"""
  PENDING_DISTILLATION

  """All automated preparation complete"""
  READY

  """Error during volume discovery"""
  ERROR_VOLUME

  """Error during distillation analysis"""
  ERROR_DISTILLATION
}

"""
Aggregated volume statistics over a time period.
Pie chart breakdown: unknown + valuable + waste + saved = total.
"""
type LogEventVolumeSeriesAggregate {
  """Total volume across all categories (log count)"""
  totalVolume: Float!

  """Volume not yet classified (no distillation)"""
  unknownVolume: Float!

  """Volume of valuable logs (keep=all distillation)"""
  valuableVolume: Float!

  """Volume identified as waste (drop distillation, not yet impacted)"""
  wasteVolume: Float!

  """Volume being saved (drop distillation with impact detected)"""
  savedVolume: Float!

  """Total bytes across all categories"""
  totalBytes: Float!

  """Bytes not yet classified"""
  unknownBytes: Float!

  """Bytes of valuable logs"""
  valuableBytes: Float!

  """Bytes identified as waste"""
  wasteBytes: Float!

  """Bytes being saved"""
  savedBytes: Float!

  """Start of the time period"""
  periodStart: Time!

  """End of the time period"""
  periodEnd: Time!
}

