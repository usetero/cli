"""Classification of log volume based on distillation recommendations"""
enum VolumeClassification {
  """No distillation exists - classification unknown"""
  UNKNOWN

  """Distillation says keep=all - logs are valuable"""
  VALUABLE

  """
  Distillation says drop but impact not yet detected - waste not yet saved
  """
  WASTE

  """Distillation says drop and impact detected - actively saving money"""
  SAVED
}

"""A single hour in a volume time series."""
type VolumeSeriesPoint {
  """Start of the hour bucket"""
  timestamp: Time!

  """The Datadog log index this volume came from"""
  datadogLogIndexID: ID!

  """Log count for this hour (actual, zero-filled, or projected)"""
  volume: Float!

  """Estimated bytes for this hour (volume * avg_bytes)"""
  bytes: Float!

  """Volume classification based on distillation status"""
  classification: VolumeClassification!
}

