# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
!internal/powersync/extension/extensions/*.so
!internal/powersync/extension/extensions/*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Environment files
.env

# Build/distribution artifacts
dist/
/tero

# Editor/IDE files
.vscode/
.idea/

# OS-specific files
.DS_Store

# Development tools
.task/

# Private documentation
docs/VISION.md
.hermit/
tmp/
/admin

# PowerSync raw fixture captures (local/on-demand only, never commit)
fixtures/powersync/*raw*.ndjson
fixtures/powersync/prd-*.ndjson
fixtures/powersync/dev-raw-*.ndjson
